# Optional named AWS CLI profile. Leave unset to use the standard AWS credential chain.
CLAIMS_AWS_PROFILE=
CLAIMS_AWS_REGION=us-east-1
CLAIMS_AWS_EVIDENCE_REGION=us-east-1

# Replace these examples with resources in your own AWS account.
CLAIMS_AWS_BUCKET=example-claims-bucket
CLAIMS_AWS_CLAIMS_TABLE=example-claims-assessments
CLAIMS_AWS_DOCUMENT_PROCESSING_FUNCTION=example-document-processing
CLAIMS_AWS_VEHICLE_IMAGE_PROCESSING_FUNCTION=example-vehicle-image-processing
CLAIMS_AWS_AGENT_DOCUMENT_APPROVAL_FUNCTION=example-agent-document-approval

# Lambda validation configuration.
EXTRACTED_DOCUMENT_BUCKET=example-extracted-documents
CLAIMS_DATA_BUCKET=example-claims-data
CLAIMS_DATA_REGION=us-east-1
RESULTS_BUCKET=example-extracted-vehicle-data
RESULTS_REGION=us-east-1
CLAIMS_TABLE=example-claims-assessments
DYNAMODB_REGION=us-east-1
ASSESSMENT_THRESHOLD=80
EXPECTED_VIEWS=front_left,front_right,rear_left,rear_right
MIN_REQUIRED_IMAGES=4
CONSISTENCY_PASS_THRESHOLD=80
CONSISTENCY_REVIEW_THRESHOLD=60
